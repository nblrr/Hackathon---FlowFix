# FlowFix Root Environment — salin ke .env dan isi nilainya
# File .env TIDAK akan di-commit ke GitHub (sudah di .gitignore)

# === Path lokal ===
FLOWFIX_PHP=C:\xampp\php\php.exe
FLOWFIX_PYTHON=C:\path\to\langflow\.venv\Scripts\python.exe

# === LLM Server ===
# LAN IP mesin yang menjalankan 9Router/LLM server (isi jika berbeda mesin)
# Kosongkan atau isi 127.0.0.1 jika LLM server jalan di mesin yang sama
FLOWFIX_LLM_HOST=127.0.0.1
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=hacka

# === Langflow ===
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
LANGFLOW_FOLDER_ID=
